{
  "name": "pkpdsim-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tangible table applications of the PBPK/PD models of pkpdsim, driven by TUIO",
  "license": "MIT",
  "author": "Matthias K\u00f6nig",
  "repository": {
    "type": "git",
    "url": "https://github.com/matthiaskoenig/pkpdsim-tui.git"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:cardiovascular": "npm run dev --workspace @pkpdsim-tui/cardiovascular -- --port 5173 --strictPort",
    "dev:lobes": "npm run dev --workspace @pkpdsim-tui/lobes -- --port 5174 --strictPort",
    "dev:glimepiride": "npm run dev --workspace @pkpdsim-tui/glimepiride -- --port 5175 --strictPort",
    "build": "npm run build --workspaces --if-present",
    "preview:cardiovascular": "npm run preview --workspace @pkpdsim-tui/cardiovascular -- --port 4173 --strictPort",
    "preview:lobes": "npm run preview --workspace @pkpdsim-tui/lobes -- --port 4174 --strictPort",
    "preview:glimepiride": "npm run preview --workspace @pkpdsim-tui/glimepiride -- --port 4175 --strictPort",
    "simulator": "node packages/tuio-simulator/src/server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sync": "node scripts/sync-assets.mjs",
    "export:glimepiride": "uv run python scripts/export_model.py --sbml ${GLIMEPIRIDE_MODEL:-../glimepiride-model/models/glimepiride_body_flat.xml} --output apps/glimepiride/public/assets/solver",
    "docs": "uv run zensical serve",
    "docs:build": "uv run zensical build --clean --strict"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
