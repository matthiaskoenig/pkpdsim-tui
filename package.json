{
  "name": "pkpdsim-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tangible table applications of the PBPK/PD models of pkpdsim, driven by TUIO",
  "license": "MIT",
  "author": "Matthias König",
  "repository": {
    "type": "git",
    "url": "https://github.com/matthiaskoenig/pkpdsim-tui.git"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:app": "node scripts/dev.mjs --no-simulator",
    "dev:cardiovascular": "node scripts/dev.mjs --app cardiovascular",
    "dev:lobes": "node scripts/dev.mjs --app lobes",
    "dev:glimepiride": "node scripts/dev.mjs --app glimepiride",
    "dev:liver": "node scripts/dev.mjs --app liver",
    "dev:perfusion": "node scripts/dev.mjs --app perfusion",
    "build": "npm run build --workspaces --if-present",
    "preview": "node scripts/dev.mjs --preview",
    "simulator": "node packages/tuio-simulator/src/server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sync": "node scripts/sync-assets.mjs",
    "export:glimepiride": "uv run python scripts/export_model.py --sbml ${GLIMEPIRIDE_MODEL:-../glimepiride-model/models/glimepiride_body_flat.xml} --output apps/table/public/assets/glimepiride/solver",
    "export:perfusion": "uv run python scripts/export_model.py --sbml ${PERFUSION_MODEL:-../pkpdsim/models/rat_liver_nmp_flat.xml} --output apps/table/public/assets/perfusion/solver",
    "docs": "uv run zensical serve",
    "docs:build": "uv run zensical build --clean --strict"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
